# ---------------------------------------------------------------------------
# github-portfolio configuration
# Copy to `.env.local` for local development and set the same keys as
# environment variables (or platform secrets) in production.
# NO SECRET IS COMMITTED TO THIS REPOSITORY.
# ---------------------------------------------------------------------------

# REQUIRED — the GitHub account whose public repositories are published.
# Must be a valid GitHub username (1-39 chars, alphanumeric or single hyphens).
GITHUB_USERNAME=your-github-username

# REQUIRED in production — the canonical public origin, no trailing slash.
# Used for canonical URLs, Open Graph metadata, robots.txt and sitemap.xml.
# Local development falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# OPTIONAL — site + profile identity. Anything left empty is simply not rendered.
# Nothing is invented by the application.
SITE_NAME=Portfolio
SITE_DESCRIPTION=Public repositories, projects and code from GitHub.
PROFILE_NAME=
PROFILE_HEADLINE=
PROFILE_BIO=
PROFILE_LOCATION=

# OPTIONAL — contact links. Only rendered when a real value is supplied.
# PROFILE_EMAIL must be a valid address; the URL values must be absolute https URLs.
PROFILE_EMAIL=
PROFILE_RESUME_URL=
PROFILE_LINKEDIN_URL=
PROFILE_WEBSITE_URL=

# OPTIONAL — repository inclusion policy (defaults shown).
# Forks are excluded by default; archived repositories are shown with a badge.
GITHUB_INCLUDE_FORKS=false
GITHUB_INCLUDE_ARCHIVED=true
# Comma-separated repository names to hide, e.g. dotfiles,scratch
GITHUB_EXCLUDED_REPOS=
# Comma-separated repository names to pin to the featured section.
# Leave empty to feature the most-starred repositories automatically.
GITHUB_FEATURED_REPOS=
GITHUB_FEATURED_COUNT=3

# OPTIONAL — data freshness and safety limits.
# 900 s = the documented 15-minute freshness target.
GITHUB_CACHE_TTL_SECONDS=900
GITHUB_MAX_PAGES=10
GITHUB_REQUEST_TIMEOUT_MS=8000
GITHUB_MAX_RETRIES=2

# OPTIONAL — server-only credential. Never prefix with NEXT_PUBLIC_ and never
# commit it. A fine-grained token with read-only access to public repositories
# raises the rate limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN=

# ADVANCED — override the API base for GitHub Enterprise Server, or a local
# mock server in tests. Non-default values in production require
# ALLOW_NON_DEFAULT_GITHUB_API=true (an explicit, deliberate opt-in).
# GITHUB_API_BASE_URL=https://api.github.com
# ALLOW_NON_DEFAULT_GITHUB_API=false

# OPTIONAL — API rate limiting to prevent abuse (defaults shown).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_BYPASS_TOKEN=  # Optional: token to bypass rate limiting for trusted services

# OPTIONAL — response size limits to prevent memory exhaustion (defaults shown).
# GITHUB_MAX_RESPONSE_SIZE_MB=10

# OPTIONAL — sitemap pagination for large portfolios (defaults shown).
# SITEMAP_MAX_URLS=1000

# OPTIONAL — memory limits to prevent exhaustion (defaults shown).
# GITHUB_MAX_REPOSITORIES=2000
